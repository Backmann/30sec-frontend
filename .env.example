# Веб-клиент 30sec — пример конфигурации.
# Скопируйте в .env.local и подставьте свои адреса.
#
# Обе переменные с префиксом NEXT_PUBLIC_ попадают в клиентскую сборку
# и видны в браузере. Секреты сюда не добавлять.

# Базовый URL API. Локально — адрес запущенного бэкенда.
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL для Socket.IO. Обычно тот же хост, что и API.
# В продакшне — wss://, локально — ws://
NEXT_PUBLIC_WS_URL=ws://localhost:3000
